# Supabase — service role key (server-side / pipeline use only)
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_service_role_key

# Supabase — anon key (Next.js frontend, public)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: AISHub API key for live AIS data
# Register at https://www.aishub.net/
AISHUB_API_KEY=optional
