# Supabase — service role key (server-side / pipeline use only)
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_service_role_key

# Supabase — anon key (Next.js frontend, public)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# aisstream.io — free real-time worldwide AIS WebSocket stream
# Register at https://aisstream.io to get your free API key
# When set, the pipeline appends live vessel positions to the CSV data
AISSTREAM_API_KEY=your_aisstream_io_api_key

# Frontend mode: "demo" (CSV data from Supabase) or "live" (aisstream.io real-time)
NEXT_PUBLIC_MODE=demo
